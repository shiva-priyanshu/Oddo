{
  "name": "subscriptiq-backend",
  "version": "1.0.0",
  "description": "Backend API server and database layer for SubscriptIQ Subscription Management System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx src/test-auth.ts && tsx src/test-plans-subs.ts && tsx src/test-billing.ts && tsx src/test-dashboard.ts && tsx src/test-checkout.ts",
    "test:auth": "tsx src/test-auth.ts",
    "test:plans-subs": "tsx src/test-plans-subs.ts",
    "test:billing": "tsx src/test-billing.ts",
    "test:dashboard": "tsx src/test-dashboard.ts",
    "test:checkout": "tsx src/test-checkout.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
